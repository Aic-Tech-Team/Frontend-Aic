# Client-visible (inlined at build time). No spaces around `=`.
# Must include the /api prefix — backend mounts routes at /api/v1/...
#
# For local View Source / SEO HTML to contain posts, Node must reach this URL.
# Prefer a local backend (http://localhost:8000/api). A public host that only
# the browser can reach will leave SSR empty.
PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_API_VERSION=1.0

# Server-only, read at runtime. Never inlined, never sent to the browser.
#
# Address the BACKEND is reachable at *from inside this container*. In the
# docker deployment that is the backend's container name on the shared network.
# Leave unset for local dev when NEXT_PUBLIC_API_BASE_URL already works from Node.
#
# Must include the /api prefix.
#API_INTERNAL_BASE_URL=http://app-backend:8000/api

# Name of the docker network the backend project created. Verify with
# `docker network ls`.
#BACKEND_NETWORK_NAME=backend-aic-main_app-network
