# Client-visible media origin. Inlined at build time. No spaces around `=`.
# Must include the /api prefix — backend mounts routes at /api/v1/...
PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_API_VERSION=1.0

# Server-side fetch, read at runtime (not inlined). Use the backend's Docker
# DNS name when the public host is unreachable from inside this container.
# Empty falls back to NEXT_PUBLIC_API_BASE_URL.
# API_BASE_URL=http://api:8000/api

# Name of the docker network the backend project created. Verify with
# `docker network ls`. Only needed so this frontend can join the shared network.
#BACKEND_NETWORK_NAME=backend-aic-main_app-network
